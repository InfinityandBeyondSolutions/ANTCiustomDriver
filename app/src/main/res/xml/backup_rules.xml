<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Authentication, encrypted credentials, active shifts, and offline write queues are
         device-bound runtime state. Restoring them can make a new device resume another device's
         session or load encrypted data without the original Android Keystore key. -->
    <exclude domain="sharedpref" path="secure_prefs.xml" />
    <exclude domain="sharedpref" path="session_prefs.xml" />
    <exclude domain="sharedpref" path="app_prefs.xml" />
    <exclude domain="database" path="." />
</full-backup-content>
